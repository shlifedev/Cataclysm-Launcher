{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cataclysm Hub",
  "version": "0.1.0",
  "identifier": "gg.cataclysm.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cataclysm Hub",
        "width": 820,
        "height": 650,
        "minWidth": 820,
        "minHeight": 650,
        "resizable": true,
        "maximizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com https://github.com; img-src 'self' data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
